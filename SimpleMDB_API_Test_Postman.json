					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{baseUrl}}/movies?page=1&size=5",
							"host": ["{{baseUrl}}"],
							"path": ["movies"],
							"query": [
